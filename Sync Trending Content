name: Sync Trending Content

on:
  schedule:
    - cron: '0 6 * * *'
  workflow_dispatch:

jobs:
  sync-trending:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          cd scripts/trending
          pip install -r requirements.txt

      - name: Run trending sync
        env:
          NOTION_API_KEY: ${{ secrets.NOTION_API_KEY }}
          NOTION_TRENDING_CONTENT_DB_ID: ${{ secrets.NOTION_TRENDING_CONTENT_DB_ID }}
        run: |
          cd scripts/trending
          python run_daily.py
